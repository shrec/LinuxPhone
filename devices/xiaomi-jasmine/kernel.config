# Appended to sdm660_defconfig. build.sh fails if any of these don't stick.
# Everything needed to reach the rootfs is built in: our initramfs carries no modules.
CONFIG_MMC_SDHCI_MSM=y
CONFIG_SDM_GCC_660=y
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
# Text console on the bootloader-initialised framebuffer, font readable at 1080px.
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
# USB networking for SSH, uinput for the on-screen keyboard.
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_INPUT_UINPUT=y
# Boot logo (assets/logo.svg, drawn by fbcon above the console text).
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
