#!/bin/sh
# Expose a USB NCM network interface (usb0) to the computer.
# Windows 11, Linux and macOS have NCM drivers built in.
set -e
G=/sys/kernel/config/usb_gadget/g1
[ -e "$G/UDC" ] && [ -n "$(cat "$G/UDC")" ] && exit 0

for i in $(seq 50); do [ -n "$(ls /sys/class/udc 2>/dev/null)" ] && break; sleep 0.2; done

mkdir -p "$G/strings/0x409" "$G/functions/ncm.usb0" "$G/configs/c.1/strings/0x409"
echo 0x1d6b > "$G/idVendor"   # Linux Foundation (18d1:d001 collides with Google's ADB driver)
echo 0x0104 > "$G/idProduct"  # Multifunction Composite Gadget
echo 0x0200 > "$G/bcdDevice"  # bump when descriptors change: Windows caches them per VID/PID/bcdDevice
# Declare CDC-NCM on the device itself so Windows binds UsbNcm directly; through its
# composite driver (usbccgp) the device fails with Code 10.
echo 0x02 > "$G/bDeviceClass"
echo 0x0d > "$G/bDeviceSubClass"
echo revive > "$G/strings/0x409/manufacturer"
cat /etc/hostname > "$G/strings/0x409/product"
cut -c1-16 /etc/machine-id > "$G/strings/0x409/serialnumber" 2>/dev/null || true
echo "USB network" > "$G/configs/c.1/strings/0x409/configuration"
ln -sf "$G/functions/ncm.usb0" "$G/configs/c.1/"
ls /sys/class/udc | head -n1 > "$G/UDC"
