[Unit]
Description=revive shell
After=systemd-user-sessions.service systemd-logind.service
Conflicts=getty@tty1.service buffyboard.service
# Never leave a dead screen: after repeated crashes give tty1 back to the text console.
OnFailure=getty@tty1.service buffyboard.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
User=phone
# A real logind session: GPU/input access, /run/user/1000 and systemd --user for apps.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty1
UtmpMode=user
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
# libadwaita (GNOME Calls, Chats, Contacts) reads the color scheme only from the settings portal,
# which revive does not run. Measured on the Mi A2: a gsettings override of
# org.gnome.desktop.interface color-scheme is ignored, while this variable turns the apps dark.
# Apps inherit it because AppModel starts them from the shell's environment.
Environment=XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=revive ADW_DEBUG_COLOR_SCHEME=prefer-dark
ExecStart=/usr/bin/phoc -C /etc/phoc/phoc.ini -E /usr/bin/revive-shell
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
