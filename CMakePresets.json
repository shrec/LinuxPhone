{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-mingw",
      "generator": "MinGW Makefiles",
      "binaryDir": "$env{TEMP}/revive-build-win",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/Qt/6.10.1/mingw_64",
        "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/Qt/Tools/mingw1310_64/bin/mingw32-make.exe",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw"
    }
  ],
  "testPresets": [
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-mingw",
      "steps": [
        {
          "type": "configure",
          "name": "windows-mingw"
        },
        {
          "type": "build",
          "name": "windows-mingw"
        },
        {
          "type": "test",
          "name": "windows-mingw"
        }
      ]
    }
  ]
}
